    "rules": [
      {
        "name": "The Scoped Portal Rule",
        "body": "Corporate portal tokens apply only to the public landing; workspace tokens remain canonical for authenticated work.",
        "section": "colors"
      },
      {
        "name": "The Honest Image Rule",
        "body": "Identify the PPSAS architectural illustration in alternative text and retain provenance in project documentation.",
        "section": "components"
